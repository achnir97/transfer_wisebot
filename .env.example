# ─── Required ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=8743906933:AAEPpafsEJw1rYRdwoABFQy2gIE2VqVhlys

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Recommended (for live exchange rates) ────────────────
# Free tier: 1,500 req/month — sign up at exchangerate-api.com
EXCHANGE_RATE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Optional ─────────────────────────────────────────────
# Wise public rate API (improves rate accuracy, no key needed for basic use)
WISE_API_KEY=

# Security salt for hashing user IDs in referral tracking
# Change this to any random 32-char string
REFERRAL_SALT=change_this_to_something_random_32chars

# Your Telegram user ID — enables /admin command (get it from @userinfobot)
ADMIN_USER_ID=

# ─── Click Tracking (tracker.py) ──────────────────────────
# Public URL of your deployed tracker.py service.
# When set, all "Send Here" buttons route through your server first,
# giving you REAL click data instead of just intent data.
# Example: https://bridge-tracker.up.railway.app
TRACKING_BASE_URL=

# Password to protect your /stats dashboard on the tracker
# Visit: https://your-tracker-url/stats?secret=your_password
STATS_SECRET=change_this_to_a_secret_password
